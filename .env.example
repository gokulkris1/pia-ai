# ── LLM: Milestone 1 hardcodes Claude via LLM_ENGINE ────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_ENGINE=claude

# ── STT: Whisper via OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── TTS: ElevenLabs ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=zGjIP4SZlMnY9m93k97r   # default = Hope (warm, natural, female)
ELEVENLABS_MODEL=eleven_turbo_v2_5         # low-latency; or eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45                  # ~45%: composed, consistent
ELEVENLABS_SIMILARITY=0.9                   # high: stays true to the voice

# ── Google Calendar OAuth: Cloud Run backend callback ───────────────────────
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=https://pia-backend-REPLACE_WITH_CLOUD_RUN_URL.a.run.app/api/calendar/callback
GOOGLE_CALENDAR_TOKEN_JSON=
GOOGLE_CALENDAR_TOKEN_PATH=
PIA_TIMEZONE=Europe/Dublin

# ── App URLs: Firebase frontend + Cloud Run API ─────────────────────────────
APP_BASE_URL=https://pia-ai-REPLACE_WITH_FIREBASE_SITE.web.app
PIA_API_BASE=https://pia-backend-REPLACE_WITH_CLOUD_RUN_URL.a.run.app
PIA_USER_ID=default

# ── Realtime voice (Vapi) — optional; classic loop is the fallback ──────────
# PIA_VOICE_MODE=vapi enables WebRTC voice; anything else keeps the classic
# record → transcribe → chat → speak loop. The two voice webhooks are gated by
# VAPI_WEBHOOK_SECRET (must match the Server URL Secret set on the Vapi side).
PIA_VOICE_MODE=classic
VAPI_WEBHOOK_SECRET=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_MAX_SESSION_SECONDS=600                # cost guardrail: max call length
DEEPGRAM_MODEL=nova-2                        # STT model (Deepgram)
