users/default/voice_sample.*
users/default/avatar_original.*
users/default/google_calendar_token.json
users/*/pia_state.json
frontend/avatar.jpg

# Editor
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Legacy local Netlify folder, if generated by older tooling
.netlify
